{
  "name": "the_last_mile",
  "private": true,
  "version": "1.12.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "package": "npm run build && cd dist && zip -r -X ../the_last_mile_web.zip . && cd ..",
    "upload": "npm run package && butler push the_last_mile_web.zip choicehoney/last-mile:html --userversion $npm_package_version",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.8",
    "@astryxdesign/theme-neutral": "^0.1.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
